---
/**
 * Author, date, reading time and categories for a single post.
 *
 * One component, three looks (blog, tech, docs). Every part is optional and
 * simply absent when there is no data, so the row never shows an empty gap or
 * a stray separator. Separators are drawn with CSS between the parts that are
 * actually present, and each part is nowrap, so the row wraps cleanly at 375px.
 * Colours are theme tokens only (muted text, full-strength for the author).
 */
import { cleanSiteText } from '../../lib/site';

interface Cat { name: string; slug: string }
interface Props {
  author?: { name: string; slug: string; avatar?: string | null } | null;
  publishedAt: string;
  dateLabel: string;
  readingTime?: string;
  categories?: Cat[];
  avatarClass?: string;
  variant?: 'blog' | 'tech' | 'docs';
}

const { author, publishedAt, dateLabel, readingTime = '', categories = [], avatarClass = 'rounded-full', variant = 'blog' } = Astro.props;
const authorName = author ? cleanSiteText(author.name) : '';
const cats = categories.map((c) => ({ ...c, name: cleanSiteText(c.name) })).filter((c) => c.name !== '');
---
<div class:list={['hatch-meta', `hatch-meta--${variant}`]}>
  <ul class="hatch-meta__row">
    {authorName && (
      <li class="hatch-meta__author">
        {author?.slug ? (
          <a href={`/blog/author/${author.slug}`}>
            {author.avatar && <img src={author.avatar} alt="" width="24" height="24" class={avatarClass} loading="lazy" decoding="async" />}
            <span>{authorName}</span>
          </a>
        ) : (
          <span>{authorName}</span>
        )}
      </li>
    )}
    {dateLabel && (
      <li><time datetime={publishedAt}>{dateLabel}</time></li>
    )}
    {readingTime && <li>{readingTime}</li>}
  </ul>
  {cats.length > 0 && (
    <ul class="hatch-meta__cats" aria-label="Categories">
      {cats.map((c) => (
        <li><a href={`/blog/category/${c.slug}`}>{c.name}</a></li>
      ))}
    </ul>
  )}
</div>

<style>
  .hatch-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1.25rem;
    margin-block: 1.25rem 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--hatch-fg-muted);
  }
  .hatch-meta ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hatch-meta__row {
    gap: 0.25rem 0;
  }
  .hatch-meta__row > li {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  /* Separator drawn only between parts that exist. */
  .hatch-meta__row > li + li::before {
    content: '';
    inline-size: 3px;
    block-size: 3px;
    margin-inline: 0.75rem;
    border-radius: 9999px;
    background: var(--hatch-fg-subtle);
    flex: none;
  }
  .hatch-meta__author a,
  .hatch-meta__author > span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--hatch-fg);
    font-weight: 500;
    text-decoration: none;
  }
  .hatch-meta__author a:hover,
  .hatch-meta__author a:focus-visible {
    color: var(--hatch-primary);
  }
  .hatch-meta__author img {
    flex: none;
    object-fit: cover;
    inline-size: 1.5rem;
    block-size: 1.5rem;
  }
  .hatch-meta__cats {
    gap: 0.375rem;
  }
  .hatch-meta__cats a {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    border: 1px solid var(--hatch-border, currentColor);
    border-radius: 9999px;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--hatch-fg-muted);
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }
  .hatch-meta__cats a:hover,
  .hatch-meta__cats a:focus-visible {
    color: var(--hatch-primary);
    border-color: var(--hatch-primary);
  }

  /* Tech: terminal flavour. Key names are text, so they stay readable and wrap with their value. */
  .hatch-meta--tech {
    font-family: var(--hatch-font-mono, ui-monospace, monospace);
    font-size: 0.78125rem;
  }
  .hatch-meta--tech .hatch-meta__cats a {
    border-radius: 0.25rem;
  }

  /* Docs: tighter, quieter. */
  .hatch-meta--docs {
    margin-block-start: 0.75rem;
    font-size: 0.8125rem;
    gap: 0.5rem 1rem;
  }
  .hatch-meta--docs .hatch-meta__cats a {
    border-radius: 0.375rem;
  }

  @media (max-width: 480px) {
    .hatch-meta {
      gap: 0.5rem 0.75rem;
    }
    .hatch-meta__row > li + li::before {
      margin-inline: 0.5rem;
    }
  }
</style>
