---
/**
 * DocsNavList: the category list used by DocsSidebar. Kept separate so the
 * same markup renders in the desktop rail and in the collapsed mobile menu.
 */
interface Category { slug: string; name: string; count: number }
interface Props {
  categories: Category[];
  activeCategorySlug?: string | null;
  label: string;
}
const { categories, activeCategorySlug = null, label } = Astro.props;
const rowBase = 'flex items-center justify-between gap-2 px-3 py-1.5 rounded-md text-[13px] transition-colors';
const rowIdle = 'text-hatch-fg-muted hover:text-hatch-fg hover:bg-hatch-bg-2';
const rowActive = 'bg-hatch-bg-3 text-hatch-fg font-medium';
---

<nav aria-label={label} class="flex flex-col gap-0.5">
  <a
    href="/blog"
    aria-current={!activeCategorySlug ? 'page' : undefined}
    class:list={[rowBase, !activeCategorySlug ? rowActive : rowIdle]}
  >
    <span>All posts</span>
  </a>

  {categories.length > 0 && (
    <>
      <div class="text-[10px] font-semibold uppercase tracking-widest text-hatch-fg-subtle mt-5 mb-2 px-3">Categories</div>
      {categories.map((cat) => (
        <a
          href={`/blog/category/${cat.slug}`}
          aria-current={activeCategorySlug === cat.slug ? 'page' : undefined}
          class:list={[rowBase, activeCategorySlug === cat.slug ? rowActive : rowIdle]}
        >
          <span class="truncate">{cat.name}</span>
          <span class="text-[11px] text-hatch-fg-subtle tabular-nums shrink-0">{cat.count}</span>
        </a>
      ))}
    </>
  )}

  {categories.length === 0 && (
    <p class="text-[12px] text-hatch-fg-subtle px-3 py-2">No categories yet. Posts will be grouped here once you add categories in WordPress.</p>
  )}
</nav>
