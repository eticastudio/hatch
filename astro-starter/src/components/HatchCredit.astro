---
/**
 * "Built with Hatch" footer credit. Renders only when the site owner turns on
 * the built_by_hatch feature (off by default). It is plain text unless the owner
 * also sets PUBLIC_HATCH_CREDIT_URL, so no external link ships by default.
 */
interface Props {
  show: boolean;
}
const { show } = Astro.props;
const creditUrl = String(import.meta.env.PUBLIC_HATCH_CREDIT_URL || '').trim();
const safeUrl = /^https:\/\//i.test(creditUrl) ? creditUrl : '';
---
{show && (
  safeUrl ? (
    <a
      href={safeUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-[12px] text-hatch-fg-subtle hover:text-hatch-fg transition-colors"
    >
      <img src="/brand/hatch-symbol.svg" alt="" width="14" height="14" class="h-3.5 w-3.5 shrink-0" aria-hidden="true" loading="lazy" />
      <span>Built with <span class="text-hatch-fg-muted font-medium">hatch</span></span>
    </a>
  ) : (
    <span class="inline-flex items-center gap-1.5 text-[12px] text-hatch-fg-subtle">
      <img src="/brand/hatch-symbol.svg" alt="" width="14" height="14" class="h-3.5 w-3.5 shrink-0" aria-hidden="true" loading="lazy" />
      Built with <span class="text-hatch-fg-muted font-medium">hatch</span>
    </span>
  )
)}
