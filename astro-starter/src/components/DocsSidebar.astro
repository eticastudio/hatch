---
/**
 * DocsSidebar: category navigation for the docs design.
 *
 * Desktop (lg and up): a sticky rail. Below lg: a collapsed "Browse topics"
 * menu so the list never pushes the content a full screen down.
 * Used through DocsShell on every docs page, and by the docs single post.
 */
import { getCategories } from '../lib/hatch';
import DocsNavList from './DocsNavList.astro';

interface Props {
  /** Slug of the category currently being viewed (if any). Drives the active highlight. */
  activeCategorySlug?: string | null;
  /** Show the sidebar's own "Browse" heading. Default true. */
  showHeading?: boolean;
}

const { activeCategorySlug = null, showHeading = true } = Astro.props;

// Tolerate any shape: only slug, name and count are needed.
const rawCats: any[] = await getCategories().catch(() => []);
const categories = (rawCats || [])
  .filter((c: any) => (c?.count ?? 0) > 0)
  .sort((a: any, b: any) => (b?.count ?? 0) - (a?.count ?? 0));
---

<aside class="hatch-docs-sidebar lg:sticky lg:top-14 lg:self-start min-w-0">
  <details class="hatch-docs-mobilenav lg:hidden">
    <summary>
      <span>Browse topics</span>
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6l4 4 4-4" /></svg>
    </summary>
    <div class="hatch-docs-mobilenav__panel">
      <DocsNavList categories={categories} activeCategorySlug={activeCategorySlug} label="Topics" />
    </div>
  </details>

  <div class="hatch-docs-rail hidden lg:block">
    {showHeading && (
      <div class="text-[11px] font-semibold uppercase tracking-widest text-hatch-fg-subtle mb-3 px-2">Browse</div>
    )}
    <DocsNavList categories={categories} activeCategorySlug={activeCategorySlug} label="Topics" />
  </div>
</aside>

<style>
  .hatch-docs-rail {
    max-height: calc(100vh - 56px);
    overflow-y: auto;
    padding: 24px 16px 24px 0;
  }
  .hatch-docs-mobilenav {
    border: 1px solid var(--color-hatch-border);
    border-radius: 8px;
    background: var(--color-hatch-bg-2);
  }
  .hatch-docs-mobilenav > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.625rem 0.875rem;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-hatch-fg);
    cursor: pointer;
    list-style: none;
    min-height: 44px;
  }
  .hatch-docs-mobilenav > summary::-webkit-details-marker { display: none; }
  .hatch-docs-mobilenav > summary svg { transition: transform 160ms ease; }
  .hatch-docs-mobilenav[open] > summary svg { transform: rotate(180deg); }
  .hatch-docs-mobilenav__panel {
    padding: 0.25rem 0.5rem 0.75rem;
    border-top: 1px solid var(--color-hatch-border);
    max-height: 60vh;
    overflow-y: auto;
  }
</style>
