---
/**
 * SiteHeader — clean, centered per-theme header.
 *
 * v0.4.0 foundation rewrite: 3 themes, each with a distinct structural
 * pattern that matches the theme CSS class contract.
 *
 *   blog  — 3-col masthead (date · wordmark · actions), double-rule below,
 *           centered nav row underneath.
 *   tech  — mono prompt left, mono nav with vertical separators right.
 *   docs  — centered wordmark + version chip stacked over a centered nav row.
 *
 * All three respect the shared aesthetic.header config (sticky, blur,
 * color_mode_button, brand_display) and pull the WP primary menu from
 * features. The mobile drawer + color-mode + hide-on-scroll JS at the
 * bottom is shared infrastructure.
 */
import type { HatchFeatures } from '../lib/features';
import type { HatchMenuItem } from '../lib/hatch';
import { siteName as resolveSiteName } from '../lib/site';
import StoreIcons from './StoreIcons.astro';
import { isStoreIconLink } from '../lib/woo';

interface Props {
  features: HatchFeatures;
  menuItems?: HatchMenuItem[];
}

const { features, menuItems = [] } = Astro.props;
const siteName = resolveSiteName(features.site);
const logoUrl  = (features.site.logo_url || '').trim();

const headerCfg = features.aesthetic.header;
const headerStickyClass =
  headerCfg.sticky === 'static' ? 'relative' :
  headerCfg.sticky === 'hide_on_scroll' ? 'sticky top-0 hatch-header-hide-on-scroll' :
  'sticky top-0';
const headerBgClass = headerCfg.blur ? 'bg-hatch-bg/95 backdrop-blur' : 'bg-hatch-bg';
const showColorModeBtn = headerCfg.color_mode_button;

const brandDisplay = headerCfg.brand_display || 'auto';
// The site name must never vanish: if the design says "logo" but no logo is
// uploaded, fall back to the text wordmark instead of rendering an empty brand.
const showLogo = !!logoUrl && brandDisplay !== 'text';
const showText = brandDisplay === 'text' || brandDisplay === 'both' || !showLogo;

const topItems = menuItems.filter((item) => item.parent === 0).sort((a, b) => a.order - b.order);

// v0.4.1 — Honest fallback. The old hardcoded `/blog` link 404'd whenever
// the user hadn't assigned a Posts Page in WP Reading (now the default
// thanks to the strict gate in pages/blog/index.astro). Shipping a link
// that leads to 404 is worse than shipping no link at all. The fallback
// now only surfaces a link IF the user actually has a posts archive at
// a real URL — using whatever slug they assigned (posts_page_slug).
const fallbackNav: { href: string; label: string; target: string }[] = [];
if ((features.home.posts_page_id ?? 0) > 0 && features.home.posts_page_slug) {
  const slug = features.home.posts_page_slug;
  fallbackNav.push({
    href: '/' + slug,
    // Title-case the slug for the visible label so "articles" → "Articles".
    label: slug.charAt(0).toUpperCase() + slug.slice(1).replace(/-/g, ' '),
    target: '',
  });
}

const navItems = topItems.length > 0
  ? topItems
      .filter((item) => !isStoreIconLink(features, item.url))
      .map((item) => ({ href: item.url, label: item.title, target: item.target }))
  : fallbackNav;

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const theme = (features.theme || 'blog').toLowerCase();

// Docs theme version chip — pulls plugin version from features if exposed,
// otherwise renders a generic "v1" so the chip is never empty.
const docsVersion = (features as any)?.version || (features as any)?.hatch_version || 'v1';

// Blog theme date strip — locale-aware long date for the masthead edition line.
const editionDate = new Date().toLocaleDateString(features.site.language || 'en-US', {
  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
});

// Inline SVG for the color-mode button — sun + moon. Repeated three times
// so each theme branch can style its own button shell without a shared
// component pulling in tailwind classes the theme CSS would have to fight.
---

{/* ================================ BLOG ================================ */}
{/* v0.5.2 — unified to standard blog convention: logo-LEFT · menu-RIGHT ·
    hamburger-RIGHT on mobile. Per-theme signature stays via typography
    (serif Fraunces wordmark) + spacing, not by rearranging structure. */}
{(theme === 'blog' || !['tech','docs'].includes(theme)) && (
<header class={`hatch-header hatch-header-blog ${headerStickyClass} z-40 ${headerBgClass}`}>
  <div class="mx-auto px-5 sm:px-8" style="max-width: var(--hatch-max-width, 1180px)">
    <div class="hatch-header-inner">
      <a href="/" class="hatch-blog-wordmark">
        {showLogo && <img src={logoUrl} alt={siteName} class="h-8 w-auto max-w-[220px] inline-block align-middle" loading="eager" />}
        {showText && <span>{siteName}</span>}
      </a>
      {navItems.length > 0 && (
        <nav class="hatch-blog-navrow hidden lg:flex" aria-label="Primary">
          {navItems.map((item) => (
            <a href={item.href} target={item.target || undefined} class:list={[isActive(item.href) ? 'is-active' : '']}>{item.label}</a>
          ))}
        </nav>
      )}
      <StoreIcons features={features} currentPath={currentPath} />
      <form role="search" method="get" action="/search" class="hatch-header-search hidden lg:flex" aria-label="Site search">
        <label class="hatch-header-search__label" for="hatch-header-search-input"><span class="sr-only">Search</span></label>
        <input id="hatch-header-search-input" type="search" name="q" placeholder="Search" autocomplete="off" />
      </form>
      <button type="button" class="hatch-hamburger lg:hidden inline-flex items-center justify-center w-10 h-10" aria-label="Open menu" aria-controls="hatch-mobile-drawer" aria-expanded="false">
        <svg class="h-5 w-5 hatch-icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg class="h-5 w-5 hatch-icon-close hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>
)}

{/* ================================ TECH ================================ */}
{theme === 'tech' && (
<header class={`hatch-header hatch-header-tech ${headerStickyClass} z-40 ${headerBgClass}`}>
  <div class="mx-auto px-5 sm:px-8" style="max-width: var(--hatch-max-width, 1240px)">
    <div class="hatch-header-inner">
      <a href="/" class="hatch-tech-brand">
        {showLogo && <img src={logoUrl} alt={siteName} class="h-5 w-auto max-w-[140px] mr-2" loading="eager" />}
        {showText && <span>{siteName}</span>}
      </a>
      <nav class="hatch-tech-nav hidden lg:inline-flex" aria-label="Primary">
        {navItems.map((item) => (
          <a href={item.href} target={item.target || undefined} class:list={[isActive(item.href) ? 'is-active' : '']}>{item.label}</a>
        ))}
      </nav>
      <StoreIcons features={features} currentPath={currentPath} />
      <form role="search" method="get" action="/search" class="hatch-header-search hidden lg:flex" aria-label="Site search">
        <input type="search" name="q" placeholder="Search" autocomplete="off" aria-label="Search" />
      </form>
      <button type="button" class="hatch-hamburger lg:hidden inline-flex items-center justify-center w-9 h-9" style="border: 1px solid var(--hatch-border); border-radius: 3px; color: var(--hatch-fg-muted);" aria-label="Open menu" aria-controls="hatch-mobile-drawer" aria-expanded="false">
        <svg class="h-4 w-4 hatch-icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg class="h-4 w-4 hatch-icon-close hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>
)}

{/* ================================ DOCS ================================ */}
{theme === 'docs' && (
<header class={`hatch-header hatch-header-docs ${headerStickyClass} z-40 ${headerBgClass}`}>
  <div class="mx-auto px-5 sm:px-8" style="max-width: var(--hatch-max-width, 1180px)">
    <div class="hatch-header-inner">
      <a href="/" class="hatch-docs-brand">
        {showLogo && <img src={logoUrl} alt={siteName} class="h-6 w-auto max-w-[160px]" loading="eager" />}
        {showText && <span>{siteName}</span>}
      </a>
      <nav class="hatch-docs-nav hidden lg:inline-flex" aria-label="Primary">
        {navItems.map((item) => (
          <a href={item.href} target={item.target || undefined} class:list={[isActive(item.href) ? 'is-active' : '']}>{item.label}</a>
        ))}
      </nav>
      <StoreIcons features={features} currentPath={currentPath} />
      <form role="search" method="get" action="/search" class="hatch-header-search hidden lg:flex" aria-label="Site search">
        <input type="search" name="q" placeholder="Search" autocomplete="off" aria-label="Search" />
      </form>
      <button type="button" class="hatch-hamburger hatch-docs-mobile-toggle lg:hidden inline-flex items-center justify-center w-9 h-9" style="border-radius: 6px; color: var(--hatch-fg-muted);" aria-label="Open menu" aria-controls="hatch-mobile-drawer" aria-expanded="false">
        <svg class="h-4 w-4 hatch-icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg class="h-4 w-4 hatch-icon-close hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>
)}

{/* v0.4.2 — Single canonical color-mode toggle, fixed top-right.
    Previously each theme had its own button at a different position
    (center-of-navrow / inline-with-separator / right-of-nav). One
    floating button = consistent placement, easier to find, never blocks
    content. Hidden on print + when admin disables the feature. */}
{showColorModeBtn && (
  <button
    id="hatch-color-mode-btn"
    type="button"
    data-hatch-color-toggle
    aria-label="Dark mode"
    aria-pressed="false"
    title="Switch to dark mode"
    class="hatch-color-mode-toggle"
    style="position: fixed; top: 14px; right: 14px; z-index: 60; width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; border: 1px solid var(--hatch-border); background: var(--hatch-bg); color: var(--hatch-fg-muted); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); cursor: pointer; transition: color 140ms ease, border-color 140ms ease;"
  >
    <svg class="hatch-cm-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
    <svg class="hatch-cm-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
  </button>
)}

{/* ============================ SHARED DRAWER =========================== */}
<div id="hatch-mobile-drawer" class="hatch-drawer lg:hidden hidden border-t border-hatch-border bg-hatch-bg">
  <nav class="mx-auto px-5 sm:px-8 py-3 flex flex-col gap-1" aria-label="Primary mobile" style="max-width: var(--hatch-max-width, 1180px)">
    <form role="search" method="get" action="/search" class="hatch-header-search hatch-header-search--mobile flex mb-2" aria-label="Site search">
      <input type="search" name="q" placeholder="Search" autocomplete="off" aria-label="Search" style="flex:1;padding:10px 12px;border:1px solid var(--hatch-border);border-radius:6px;background:var(--hatch-bg-2);color:var(--hatch-fg);font-size:14px;" />
    </form>
    {navItems.map((item) => (
      <a href={item.href} target={item.target || undefined}
         class:list={['px-3 py-3 rounded-md text-[14px] font-medium transition-colors',
                      isActive(item.href) ? 'text-hatch-fg bg-hatch-bg-3' : 'text-hatch-fg-muted hover:text-hatch-fg hover:bg-hatch-bg-2']}>
        {item.label}
      </a>
    ))}
    <StoreIcons features={features} currentPath={currentPath} variant="drawer" />
  </nav>
</div>

<style>
  /* #177. Header search. Compact, blends with each theme's chrome. */
  .hatch-header-search { align-items: center; margin-left: 12px; }
  .hatch-header-search input[type="search"] {
    width: 180px;
    padding: 6px 10px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--hatch-fg);
    background: var(--hatch-bg-2, transparent);
    border: 1px solid var(--hatch-border);
    border-radius: 6px;
    outline: none;
    transition: border-color 140ms ease, box-shadow 140ms ease, width 160ms ease;
  }
  .hatch-header-search input[type="search"]:focus {
    border-color: var(--hatch-primary, currentColor);
    box-shadow: 0 0 0 3px rgba(0,0,0,0.06);
    width: 220px;
  }
  .hatch-header-search input[type="search"]:focus-visible {
    outline: 2px solid var(--hatch-primary, currentColor);
    outline-offset: 2px;
  }
  .hatch-header-search--mobile input[type="search"]:focus {
    width: auto;
  }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; }
  .hatch-drawer.is-open { display: block; }
  .hatch-hamburger.is-open .hatch-icon-open { display: none; }
  .hatch-hamburger.is-open .hatch-icon-close { display: inline-block; }
  :global(body.hatch-drawer-open) { overflow: hidden; }
  @media (min-width: 1024px) {
    :global(body.hatch-drawer-open) { overflow: auto; }
  }
</style>

<script>
  import '../scripts/site-header.js';
</script>
