---
/**
 * SiteFooter — clean centered footer per theme.
 *
 * v0.4.0 foundation rewrite. Three structural patterns:
 *   blog  — wordmark, tagline, horizontal small-caps link row, copyright.
 *   tech  — CLI prompt line, separator-piped link row, mono meta line.
 *   docs  — brand, link row, mono last-updated stamp.
 */
import type { HatchFeatures } from '../lib/features';
import type { HatchMenuItem } from '../lib/hatch';
import { hasFeature } from '../lib/features';
import HatchCredit from './HatchCredit.astro';

interface Props {
  features: HatchFeatures;
  menuItems?: HatchMenuItem[];
}

const { features, menuItems = [] } = Astro.props;
const siteName = features.site.name || 'Hatch';
const tagline  = features.site.description || '';
const logoUrl  = (features.site.logo_url || '').trim();
const year     = new Date().getFullYear();
const showBuiltBy = hasFeature(features, 'built_by_hatch');
const theme    = (features.theme || 'blog').toLowerCase();

const footerItems = menuItems.filter((item) => item.parent === 0).sort((a, b) => a.order - b.order);

// v0.4.1 — Same honest-fallback rule as SiteHeader. Only emit a posts
// archive link when one actually exists (posts_page_id > 0). RSS and
// sitemap always exist, so they stay. Home stays. The dead "/blog" link
// the older fallback shipped was a 404 on every default install.
const fallbackLinks: { href: string; label: string; target: string }[] = [
  { href: '/', label: 'Home', target: '' },
];
if (features.home.posts_page_id > 0 && features.home.posts_page_slug) {
  const slug = features.home.posts_page_slug;
  fallbackLinks.push({
    href: '/' + slug,
    label: slug.charAt(0).toUpperCase() + slug.slice(1).replace(/-/g, ' '),
    target: '',
  });
}
fallbackLinks.push(
  { href: '/rss.xml', label: 'RSS', target: '' },
  { href: '/sitemap-index.xml', label: 'Sitemap', target: '' },
);

const navLinks = footerItems.length > 0
  ? footerItems.map((item) => ({ href: item.url, label: item.title, target: item.target }))
  : fallbackLinks;

const docsVersion = (features as any)?.version || (features as any)?.hatch_version || 'v1';
const updatedStamp = `Last built · ${new Date().toISOString().split('T')[0]} · ${docsVersion}`;
---

{/* ================================ BLOG ================================ */}
{(theme === 'blog' || !['tech','docs'].includes(theme)) && (
<footer class="hatch-footer">
  <div class="mx-auto px-5 sm:px-8" style="max-width: var(--hatch-max-width, 1180px)">
    {logoUrl ? (
      <a href="/" class="inline-block">
        <img src={logoUrl} alt={siteName} class="h-8 w-auto mx-auto opacity-90" loading="lazy" />
      </a>
    ) : (
      <h2 class="hatch-footer-wordmark">{siteName}</h2>
    )}
    {tagline && <p class="hatch-footer-tagline">{tagline}</p>}
    <nav class="hatch-footer-links" aria-label="Footer">
      {navLinks.map((link) => (
        <a href={link.href} target={link.target || undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="hatch-footer-meta">{`© ${year} · ${siteName}`}</div>
    <div class="mt-2"><HatchCredit show={showBuiltBy} /></div>
  </div>
</footer>
)}

{/* ================================ TECH ================================ */}
{theme === 'tech' && (
<footer class="hatch-footer">
  <div class="mx-auto px-5 sm:px-8" style="max-width: var(--hatch-max-width, 1240px)">
    {/* Calm-pass dropped the `cat /about.md · {tagline}` line — too
        cute for a footer that needs to read fast. Just prompt + name. */}
    <div class="hatch-footer-prompt">{siteName.toLowerCase()}</div>
    <nav class="hatch-footer-links" aria-label="Footer">
      {navLinks.map((link) => (
        <a href={link.href} target={link.target || undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="hatch-footer-meta">{`# © ${year}`}</div>
    <div class="mt-2"><HatchCredit show={showBuiltBy} /></div>
  </div>
</footer>
)}

{/* ================================ DOCS ================================ */}
{theme === 'docs' && (
<footer class="hatch-footer">
  <div class="mx-auto px-5 sm:px-8" style="max-width: var(--hatch-max-width, 1180px)">
    <div class="hatch-footer-brand">{siteName}</div>
    <nav class="hatch-footer-links" aria-label="Footer">
      {navLinks.map((link) => (
        <a href={link.href} target={link.target || undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="hatch-footer-meta">© {year} · {siteName}</div>
    <div class="mt-2"><HatchCredit show={showBuiltBy} /></div>
  </div>
</footer>
)}
