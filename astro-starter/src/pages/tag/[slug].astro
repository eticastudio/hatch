---
/**
 * Tag archive at the WP-native URL: /tag/<slug>/
 *
 * v0.4.2 — Routes /tag/* to the full archive template living at
 * /blog/tag/[slug].astro. URL adapter only — keeps the WP `/tag/<slug>/`
 * permalink convention so inbound links survive a migration. Same
 * pattern as /category/[slug].astro.
 */
const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');
return Astro.rewrite(`/blog/tag/${slug}`);
---
