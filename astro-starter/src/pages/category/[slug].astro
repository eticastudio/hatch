---
/**
 * Category archive at the WP-native URL: /category/<slug>/
 *
 * v0.4.2 — Routes /category/* to the full archive template living at
 * /blog/category/[slug].astro. Single source of truth for the archive
 * layout; this file is just a URL adapter so links built via
 * lib/url-builder.categoryUrl() (default `category_base = "category"`)
 * resolve to a real page. Mirrors WP's `/category/<slug>/` permalink
 * convention so existing inbound links keep working when a site
 * migrates from WordPress to a Hatch frontend.
 */
const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');
return Astro.rewrite(`/blog/category/${slug}`);
---
