---
/**
 * Author archive at the WP-native URL: /author/<slug>/
 *
 * v0.4.2 — Routes /author/* to the full archive template living at
 * /blog/author/[slug].astro. URL adapter only — mirrors WP's
 * `/author/<slug>/` permalink convention.
 */
const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');
return Astro.rewrite(`/blog/author/${slug}`);
---
