# Root WordPress URL — e.g. https://wp.example.com or http://localhost:8810
HATCH_WP_API_URL=http://localhost:8810

# Optional — needed only for /edit context (drafts). Public reads use REST as anon.
HATCH_WP_API_USER=
HATCH_WP_API_PASS=

# Shared secret used by /wp-json/hatch/v1/revalidate to bust the features cache.
HATCH_WEBHOOK_SECRET=change-me

# Public site URL — used in RSS, sitemap, canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Image proxy backend (optional). Defaults to https://hatch.adityaarsharma.com.
HATCH_IMG_BACKEND=https://hatch.adityaarsharma.com
