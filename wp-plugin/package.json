{
  "name": "hatch-wp",
  "version": "0.7.6-1",
  "description": "Hatch: run WordPress as a headless CMS and deploy an Astro frontend to your own Cloudflare account. Uses standard core Gutenberg blocks.",
  "license": "GPL-2.0-or-later",
  "author": "Aditya Sharma",
  "homepage": "https://github.com/eticastudio/hatch",
  "repository": {
    "type": "git",
    "url": "https://github.com/eticastudio/hatch.git",
    "directory": "wp-plugin"
  },
  "private": true,
  "scripts": {
    "build:admin": "wp-scripts build admin-react/src/index.jsx --output-path=build/admin",
    "watch:admin": "wp-scripts start admin-react/src/index.jsx --output-path=build/admin",
    "build": "npm run build:admin"
  },
  "dependencies": {
    "@wordpress/components": "^28.0.0",
    "@wordpress/data": "^10.0.0",
    "@wordpress/element": "^6.0.0",
    "@wordpress/i18n": "^5.0.0",
    "@wordpress/icons": "^10.0.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@wordpress/scripts": "^28.0.0",
    "typescript": "^5.4.0"
  }
}
