{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hatch/group",
	"title": "Group",
	"category": "hatch",
	"icon": "screenoptions",
	"description": "Flex / grid / stack wrapper for nested blocks.",
	"keywords": [ "group", "flex", "grid", "stack", "row", "column" ],
	"version": "0.3.0",
	"textdomain": "hatch-blocks",
	"supports": { "html": false, "reusable": true, "anchor": true, "align": [ "wide", "full" ] },
	"attributes": {
		"layout":     { "type": "string", "default": "stack" },
		"gap":        { "type": "string", "default": "md" },
		"align":      { "type": "string", "default": "start" },
		"justify":    { "type": "string", "default": "start" },
		"wrap":       { "type": "boolean", "default": false },
		"tag":        { "type": "string", "default": "div" }
	}
}
